# PostgreSQL là cơ sở dữ liệu production được hỗ trợ.
# Giá trị phải đúng là "postgres" hoặc "sqlite" — config.py bật ValueError với
# mọi giá trị khác, kể cả "postgresql".
DATABASE_MODE=postgres

# Scheme phải là postgresql+psycopg2: requirements.txt ship psycopg2-binary,
# không phải psycopg (v3). Dùng sai driver thì engine không dựng được.
DATABASE_URL=postgresql+psycopg2://epl_user:CHANGE_ME@127.0.0.1:5432/epl_logistics

# Token cho các API TMS. Thay bằng một giá trị dài, sinh ngẫu nhiên.
# Token này KHÔNG bao giờ được nhúng vào HTML trả về cho khách chưa xác thực.
# Người vận hành đặt nó vào localStorage của trình duyệt một lần:
#   localStorage.setItem('EPL_TMS_API_TOKEN', '<token>')
EPL_TMS_API_TOKEN=CHANGE_ME
EPL_TMS_API_PRINCIPAL=epl-admin

# Các origin được phép gọi API, phân tách bằng dấu phẩy. Dấu * bị bỏ qua:
# kết hợp với allow_credentials=True thì mọi website đều điều khiển được API
# từ trình duyệt của nhân viên. Để trống thì chỉ localhost:8001 được phép.
EPL_CORS_ORIGINS=

# Tùy chọn: mở /docs, /redoc, /openapi.json. Mặc định đóng vì bản đặc tả trao
# trọn danh mục endpoint cho kẻ tấn công. Chỉ bật khi phát triển cục bộ.
EPL_ENABLE_DOCS=

# Tùy chọn: từ chối khởi động khi migration thất bại. Xem main._strict_startup
# — hiện chưa bật được làm mặc định vì bộ migration chưa đồng thuận với models.
EPL_STRICT_STARTUP=

# Tùy chọn: cấu hình pool kết nối PostgreSQL.
EPL_DB_CONNECT_TIMEOUT=10
EPL_DB_POOL_SIZE=10
EPL_DB_MAX_OVERFLOW=20
EPL_DB_POOL_TIMEOUT=30
EPL_DB_POOL_RECYCLE=1800

# Tùy chọn: tích hợp AI. Để trống nếu không dùng.
GEMINI_API_KEY_GT=

# GHI SỔ KINH DOANH sang QLSX (hệ công nợ của bên kế toán): nút "Ghi sổ kinh doanh"
# trên hồ sơ DO đã hoàn tất gọi POST {QLSX_BASE_URL}/api/v1/integrations/logistics/sales-orders.
# Token do đội QLSX cấp cho tài khoản tích hợp; nó chỉ nằm ở đây — hợp đồng QLSX cấm nhúng
# vào trình duyệt. ĐỂ TRỐNG cũng được: khi đó dùng lại EPL_ACC_CODE_API / EPL_ACC_CODE_TOKEN
# (API mã hạch toán, cùng hệ QLSX). Chỉ đặt riêng khi hai API dùng hai tài khoản khác nhau.
# "Xem dữ liệu gửi" luôn dùng được, không cần token.
QLSX_BASE_URL=
QLSX_ACCESS_TOKEN=
