# PostgreSQL is the supported production database.
DATABASE_MODE=postgresql
DATABASE_URL=postgresql+psycopg://epl_user:CHANGE_ME@127.0.0.1:5432/epl_logistics

# Token used by protected TMS APIs. Replace with a long random value.
EPL_TMS_API_TOKEN=CHANGE_ME
EPL_TMS_API_PRINCIPAL=epl-admin

# Optional AI integration. Leave empty when not used.
GEMINI_API_KEY_GT=

