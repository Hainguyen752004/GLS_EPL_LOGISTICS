DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/epl_lao
EPL_LAO_SECRET=chuoi-ngau-nhien-dai
# Tự đồng bộ nền với hệ kế toán anh Tune (06/10, services/dong_bo_nen.py): hỏi lại đã chi / đã thu mỗi N phút.
# 0 = tắt. Giới hạn = số bản ghi mỗi loại mỗi lượt.
EPL_DONG_BO_NEN_PHUT=5
EPL_DONG_BO_NEN_GIOI_HAN=50
# 06/10: đọc phiếu chi lương thật (trả cùng lương) — đặt 1 SAU KHI API anh Tune có đường integrations/logistics/line-vouchers.
EPL_DONG_BO_CHI_LUONG=0

# Màn đăng nhập: danh sách tài khoản mẫu để bấm nhanh (CHỈ máy thử / demo). Máy thật để 0 (mặc định) — không lộ tên tài khoản.
EPL_LAO_DANG_NHAP_MAU=0
# 08/10 (chuyển sang module Vận tải C#): 1 = màn đăng nhập dùng tài khoản GLS (API đăng nhập anh Khang, api/v2/auth/login);
# tài khoản GLS phải được Admin gắn ở màn Tài khoản (ô «Tài khoản GLS»). Tài khoản EPL cũ vẫn đăng nhập được song song.
# Token GLS (cả từ Web GLS gọi sang) được kiểm bằng api/v1/auth/info, nhớ EPL_GLS_XAC_THUC_GIAY giây (mặc định 300).
EPL_DANG_NHAP_GLS=0
EPL_GLS_XAC_THUC_GIAY=300
# 08/10 (Việc 9): 1 = khách hàng là Đối tượng GLS — thêm khách là chọn / tạo đối tượng GLS, tên · điện thoại · địa chỉ · mã của
# khách đã liên kết chỉ sửa ở màn Đối tượng GLS (trang này chép về). Bật SAU khi chạy tools/chuyen_csharp/doi_chieu_khach_gls.py --ghi.
# EPL_GLS_KHACH_GIAY: nhớ kết quả tìm khách GLS bao nhiêu giây (mặc định 300).
EPL_KHACH_GLS=0
EPL_GLS_KHACH_GIAY=300
# 08/10 (Việc 10): như EPL_KHACH_GLS cho nhà cung cấp + chủ xe liên kết (danh mục nhà cung cấp chung). Bật SAU khi chạy
# tools/chuyen_csharp/doi_chieu_khach_gls.py --loai ncc --ghi và --loai chu_xe --ghi. Tài xế (EPLTX-) không đổi.
EPL_NCC_GLS=0

# ---- Nối hệ kế toán / kho GLS-QLSX của anh Tune (chi tiết: README «Cấu hình», tài liệu triển khai mục 7) ----
# Danh mục tài khoản Lào trên API anh Tune — gốc API cũng lấy theo địa chỉ này
EPL_ACC_CODE_API=https://<địa chỉ API host>/api/v1/common/country-accounts
EPL_ACC_CODE_COUNTRY=11
# Chỉ đặt khi gốc API khác máy của EPL_ACC_CODE_API (máy thử: http://127.0.0.1:5090)
# QLSX_BASE_URL=
# Đăng nhập API: một trong ba cách — token, hoặc tài khoản tích hợp, hoặc access token
# EPL_ACC_CODE_TOKEN=
# QLSX_USERNAME=
# QLSX_PASSWORD=
# QLSX_ORG_ID=
# Web anh Tune (câu nhắc «cấp dầu / ghi sổ ở Web»)
QLSX_WEB_URL=https://<địa chỉ Web host>
# Kho ở hệ anh Tune (mặc định); kho_tam chỉ để quay lui
KHO_NGUON=qlsx
# Gửi bút toán chờ (khoá DO, tất toán…) sang API — bật 1 SAU CÙNG, khi host đã có script + cấu hình bút toán
QLSX_GUI_BUT_TOAN=0
# Dự phòng: tai_cho = tạm ứng chi tại trang điều xe khi hệ anh Tune không dùng được (để trống = chi ở hệ anh Tune)
# EPL_CHI_TAM_UNG=
