<?xml version="1.0" encoding="utf-8"?>
<!--
  Trang điều xe EPL Lào chạy dưới IIS (Windows Server) — giống cách anh Tune host API / Web C#.
  IIS giữ địa chỉ + chứng chỉ HTTPS; HttpPlatformHandler tự bật tiến trình Python (uvicorn) và chuyển yêu cầu vào.
  Chép tệp này vào THƯ MỤC GỐC repo trên máy host (cạnh README.md, .env) — thư mục vật lý của site IIS là thư mục đó.
  Hướng dẫn đầy đủ: deploy/iis/HUONG_DAN_HOST_IIS.md
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <!-- processPath: ĐỔI theo đường cài Python trên máy host.
         MỘT tiến trình (processesPerApplication="1"): trang có luồng tự đồng bộ nền — nhiều tiến trình là chạy trùng.
         uvicorn nghe 127.0.0.1 ở cổng IIS cấp (%HTTP_PLATFORM_PORT%) — người ngoài chỉ vào qua IIS. -->
    <httpPlatform processPath="C:\Python312\python.exe"
                  arguments="-X utf8 -m uvicorn backend.app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1"
                  processesPerApplication="1"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:05:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\uvicorn.log">
      <environmentVariables>
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
        <environmentVariable name="PYTHONUTF8" value="1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- ảnh phiếu quặng / POD / hợp đồng: tối đa 50 MB một lần gửi -->
        <requestLimits maxAllowedContentLength="52428800" />
        <!-- chặn thêm cho chắc: FastAPI vốn chỉ phục vụ thư mục frontend, không bao giờ trả .env / .git (KHÔNG giấu "kiem", "tep"…:
             trùng tên đường API như /api/lien-thong/kiem, /api/tep/…) -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
          <add segment=".may_thu" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
